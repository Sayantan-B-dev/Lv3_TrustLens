# ─────────────────────────────────────────────────────────────────────────────
# TrustLens frontend environment template. Copy to frontend/.env.local.
# NEVER commit .env.local or real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Backend origin used by the Next.js rewrites (server-side only).
# Same-origin /api requests are proxied here, so the browser never needs CORS.
BACKEND_URL=http://127.0.0.1:8000

# Optional: talk to the backend directly from the browser.
# Set this to the backend origin (for example http://127.0.0.1:8000) and add
# the frontend origin to the backend CORS_ORIGINS. Leave it empty to use the
# same-origin Next.js proxy above.
NEXT_PUBLIC_API_BASE_URL=
